REACT_APP_SQUARE_ENVIRONMENT=production

# API URLs (Production)
REACT_APP_API_BASE_URL=https://ativecasinoapi.up.railway.app/api

# Environment
REACT_APP_ENVIRONMENT=production

# ===========================================
# IMPORTANT: Square Environment Mismatch Fix
# ===========================================
# 
# Error: "Web Payments SDK was initialized with an application ID 
# created in production however you are currently using sandbox"
#
# SOLUTION: Set REACT_APP_SQUARE_ENVIRONMENT=production in Railway
#
# This error occurs because:
# 1. Railway has a PRODUCTION Square Application ID
# 2. But REACT_APP_SQUARE_ENVIRONMENT is not set (defaults to sandbox)  
# 3. Square SDK detects the mismatch and throws an error
#
# Fix by adding this environment variable in Railway:
# REACT_APP_SQUARE_ENVIRONMENT=production