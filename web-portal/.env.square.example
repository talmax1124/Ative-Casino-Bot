# Square Payment Integration Environment Variables
# Add these to your .env file in the web-portal directory

# ===========================================
# REQUIRED: Square Configuration
# ===========================================

# Square Application ID (from Square Dashboard)
# Sandbox example: sandbox-sq0idb-XXXXXXXXXXXXXXXXXXXXXXXXXX
# Production example: sq0idp-XXXXXXXXXXXXXXXXXXXXXXXXXX
REACT_APP_SQUARE_APPLICATION_ID=sandbox-sq0idb-YOUR_APPLICATION_ID_HERE

# Square Location ID (from Square Dashboard)
# Example: LXXXXXXXXXXXXX
REACT_APP_SQUARE_LOCATION_ID=YOUR_LOCATION_ID_HERE

# ===========================================
# OPTIONAL: Square Environment Configuration
# ===========================================

# Square Environment (defaults to sandbox if not specified)
# Options: "sandbox" or "production"
REACT_APP_SQUARE_ENVIRONMENT=sandbox

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================

# 1. Go to Square Developer Dashboard: https://developer.squareup.com/apps
# 2. Create a new application or select existing one
# 3. Copy Application ID from "Credentials" tab
# 4. Copy Location ID from "Locations" tab
# 5. For sandbox testing, use sandbox credentials
# 6. For production, use production credentials and set REACT_APP_SQUARE_ENVIRONMENT=production

# ===========================================
# TESTING
# ===========================================

# Sandbox Test Card Numbers:
# Visa: 4111 1111 1111 1111
# Mastercard: 5555 5555 5555 4444
# American Express: 3782 8224 6310 005
# CVV: Any 3-digit number (4-digit for Amex)
# Expiry: Any future date

# ===========================================
# TROUBLESHOOTING
# ===========================================

# Common Issues:
# 1. "Application ID not found" - Check your Application ID
# 2. "Location not found" - Verify Location ID matches your Square account
# 3. "SDK failed to load" - Check internet connection and Square service status
# 4. "Invalid credentials" - Ensure sandbox/production environment matches credentials

# Debug Mode (shows detailed console logs):
REACT_APP_DEBUG_SQUARE=true