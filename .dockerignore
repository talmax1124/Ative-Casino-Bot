# ATIVE Casino Bot - Docker Ignore
# Files and directories to exclude from Docker build context

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.development
.env.test
.env.production

# Logs
logs/
*.log
*.log.*

# Backups
backups/

# Temporary files
temp/
tmp/
*.tmp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/
.nyc_output/
test/

# Documentation (optional - include if needed)
Documentation & Tests/

# Build artifacts
dist/
build/

# Package manager files
.yarn/
.pnp.*
yarn.lock

# Firebase (if using local emulator)
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Database files (if using local SQLite - not applicable here)
*.sqlite
*.sqlite3
*.db

# Pterodactyl specific
egg-*.json
*.md

# Docker
Dockerfile*
docker-compose*
.dockerignore