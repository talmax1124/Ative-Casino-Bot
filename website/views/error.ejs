<%- include('partials/header') %>

<section class="hero">
    <h1 style="font-size: 4rem; margin-bottom: 20px;">⚠️</h1>
    <h2 style="color: var(--warning-color);">Oops! Something went wrong</h2>
    <p>The house always wins... except when there's a server error!</p>
    <div style="margin-top: 30px;">
        <a href="/" class="btn">Return Home</a>
        <a href="/support" class="btn btn-secondary">Get Support</a>
    </div>
</section>

<% if (typeof error !== 'undefined' && error.stack) { %>
<div class="card" style="max-width: 800px; margin: 40px auto;">
    <h3>Error Details</h3>
    <div class="code-block" style="font-size: 0.9rem; max-height: 200px; overflow-y: auto;">
        <%= error.stack %>
    </div>
</div>
<% } %>

<div class="card" style="text-align: center; max-width: 600px; margin: 40px auto;">
    <h3>🛠️ What can you do?</h3>
    <ul style="text-align: left; max-width: 300px; margin: 20px auto;">
        <li>Try refreshing the page</li>
        <li>Go back and try again</li>
        <li>Check our support server</li>
        <li>Report this issue to us</li>
    </ul>
</div>

<%- include('partials/footer') %>