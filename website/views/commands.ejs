<%- include('partials/header') %>

<section class="hero" style="padding: 40px 0;">
    <h1>⚡ Commands</h1>
    <p>Complete list of all available ATIVE Casino Bot commands</p>
</section>

<div class="card">
    <h2>🎰 Casino Games</h2>
    <div class="grid grid-2">
        <div class="command">
            <div class="command-name">/blackjack [amount]</div>
            <div class="command-description">Play classic blackjack against the dealer. Hit, stand, double down, or split your way to 21!</div>
        </div>
        
        <div class="command">
            <div class="command-name">/slots [amount]</div>
            <div class="command-description">Spin the slot machine reels and win big with various paylines and bonuses.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/crash</div>
            <div class="command-description">Join a crash game and cash out before the multiplier crashes!</div>
        </div>
        
        <div class="command">
            <div class="command-name">/rps [amount]</div>
            <div class="command-description">Challenge other players to Rock Paper Scissors matches.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/fishing [amount]</div>
            <div class="command-description">Go fishing and catch fish with different multipliers. Watch out for red fish!</div>
        </div>
        
        <div class="command">
            <div class="command-name">/plinko [amount]</div>
            <div class="command-description">Drop balls down the plinko board and win prizes based on where they land.</div>
        </div>
    </div>
</div>

<div class="card">
    <h2>💰 Economy Commands</h2>
    <div class="grid grid-2">
        <div class="command">
            <div class="command-name">/balance</div>
            <div class="command-description">Check your current wallet and bank balance.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/work</div>
            <div class="command-description">Work to earn virtual coins. Available every few hours.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/daily</div>
            <div class="command-description">Claim your daily bonus coins and streak rewards.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/deposit [amount]</div>
            <div class="command-description">Deposit coins from your wallet to your bank for safekeeping.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/withdraw [amount]</div>
            <div class="command-description">Withdraw coins from your bank to your wallet for gambling.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/pay [user] [amount]</div>
            <div class="command-description">Send coins to another user from your wallet.</div>
        </div>
    </div>
</div>

<div class="card">
    <h2>📊 Statistics & Information</h2>
    <div class="grid grid-2">
        <div class="command">
            <div class="command-name">/stats</div>
            <div class="command-description">View your detailed gaming statistics and performance.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/leaderboard</div>
            <div class="command-description">Check the top players on various leaderboards.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/mystats</div>
            <div class="command-description">View your personal game statistics and achievements.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/wealthstatus</div>
            <div class="command-description">See how your wealth compares to other players.</div>
        </div>
    </div>
</div>

<div class="card">
    <h2>🎪 Special Events</h2>
    <div class="grid grid-2">
        <div class="command">
            <div class="command-name">/lottery</div>
            <div class="command-description">Check current lottery information and prizes.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/purchaselottery [count]</div>
            <div class="command-description">Buy lottery tickets for the current drawing.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/bingo</div>
            <div class="command-description">Join bingo games and compete for prizes.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/treasurevault</div>
            <div class="command-description">Try your luck at the mysterious treasure vault.</div>
        </div>
    </div>
</div>

<div class="card">
    <h2>⚙️ Utility Commands</h2>
    <div class="grid grid-2">
        <div class="command">
            <div class="command-name">/help</div>
            <div class="command-description">Get help and information about bot commands and features.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/support</div>
            <div class="command-description">Get links to support resources and contact information.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/privacy</div>
            <div class="command-description">View privacy policy and data handling information.</div>
        </div>
        
        <div class="command">
            <div class="command-name">/stopgame</div>
            <div class="command-description">Stop your current active game session.</div>
        </div>
    </div>
</div>

<div class="card" style="background: rgba(255, 215, 0, 0.1); border-color: var(--accent-color);">
    <h2>💡 Tips for Using Commands</h2>
    <div class="grid grid-2">
        <div>
            <h3>💰 Amount Formats</h3>
            <ul>
                <li><strong>Numbers:</strong> 1000, 500, 250</li>
                <li><strong>Shortcuts:</strong> 1k, 2.5k, 1m, 1b</li>
                <li><strong>Special:</strong> all, half, max</li>
            </ul>
        </div>
        <div>
            <h3>🎯 Best Practices</h3>
            <ul>
                <li>Start with small bets to learn games</li>
                <li>Use <code>/help [command]</code> for detailed info</li>
                <li>Check your balance before large bets</li>
                <li>Use the bank to save your winnings</li>
            </ul>
        </div>
    </div>
</div>

<%- include('partials/footer') %>