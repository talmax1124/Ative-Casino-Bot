<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
</head>
<body>
    <%- include('partials/header') %>

    <main class="main-content">
        <div class="container">
            <div class="page-header">
                <h1>🛒 Casino Shop</h1>
                <p>Purchase coins and subscriptions to enhance your casino experience!</p>
            </div>

            <!-- User Profile Section -->
            <div class="user-input-section">
                <div class="input-card discord-profile">
                    <h2>👤 Discord Profile</h2>
                    <div class="profile-info">
                        <% if (user && user.avatar) { %>
                            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar" class="profile-avatar">
                        <% } else { %>
                            <div class="profile-avatar-placeholder">👤</div>
                        <% } %>
                        <div class="profile-details">
                            <h3><%= user.username %>#<%= user.discriminator %></h3>
                            <p class="user-id">ID: <%= user.id %></p>
                            <% if (user.email) { %>
                                <p class="user-email">📧 <%= user.email %></p>
                            <% } %>
                        </div>
                    </div>
                    <div class="profile-actions">
                        <a href="/logout" class="btn-secondary">🚪 Switch Account</a>
                    </div>
                    <!-- Hidden inputs for compatibility -->
                    <input type="hidden" id="userId" value="<%= user.id %>">
                    <input type="hidden" id="discordUsername" value="<%= user.username %>#<%= user.discriminator %>">
                </div>
            </div>

            <!-- Products Section -->
            <div class="products-section">
                <h2>💰 Coin Packs</h2>
                <div class="products-grid">
                    <div class="product-card" data-product="coins_200k">
                        <div class="product-icon">💎</div>
                        <h3>200K Coins Pack</h3>
                        <div class="product-price">$3.99</div>
                        <div class="product-coins">200,000 Coins</div>
                        <p class="product-description">Perfect starter pack for new casino players</p>
                        <button class="buy-btn" data-product="coins_200k" data-price="3.99" data-coins="200000">
                            Buy Now
                        </button>
                    </div>

                    <div class="product-card" data-product="coins_500k">
                        <div class="product-icon">👑</div>
                        <h3>500K Coins Pack</h3>
                        <div class="product-price">$24.99</div>
                        <div class="product-coins">1,000,000 Coins</div>
                        <p class="product-description">Great value pack for regular players</p>
                        <button class="buy-btn" data-product="coins_500k" data-price="24.99" data-coins="1000000">
                            Buy Now
                        </button>
                    </div>

                    <div class="product-card popular" data-product="coins_1m">
                        <div class="popular-badge">🔥 POPULAR</div>
                        <div class="product-icon">🚀</div>
                        <h3>2.5M Coins Pack</h3>
                        <div class="product-price">$39.99</div>
                        <div class="product-coins">2,500,000 Coins</div>
                        <p class="product-description">Ultimate coin pack for high rollers</p>
                        <button class="buy-btn" data-product="coins_1m" data-price="39.99" data-coins="2500000">
                            Buy Now
                        </button>
                    </div>
                </div>

                <h2>🎭 VIP Subscriptions</h2>
                <div class="products-grid">
                    <div class="product-card subscription" data-product="diamond_subscription">
                        <div class="product-icon">💎</div>
                        <h3>Diamond Subscription</h3>
                        <div class="product-price">$4.99<span>/month</span></div>
                        <div class="product-coins">50,000 Monthly Coins</div>
                        <ul class="product-features">
                            <li>✨ 5% bonus on all purchases</li>
                            <li>🎯 Exclusive VIP channels</li>
                            <li>💎 Diamond role & privileges</li>
                            <li>🎁 Monthly coin bonus</li>
                        </ul>
                        <button class="buy-btn" data-product="diamond_subscription" data-price="4.99" data-coins="50000">
                            Subscribe Now
                        </button>
                    </div>

                    <div class="product-card subscription premium" data-product="ruby_subscription">
                        <div class="premium-badge">⭐ PREMIUM</div>
                        <div class="product-icon">🔴</div>
                        <h3>Ruby Subscription</h3>
                        <div class="product-price">$9.99<span>/month</span></div>
                        <div class="product-coins">100,000 Monthly Coins</div>
                        <ul class="product-features">
                            <li>🚀 10% bonus on all purchases</li>
                            <li>👑 All VIP channels access</li>
                            <li>🔴 Ruby role & premium privileges</li>
                            <li>💰 Double monthly coin bonus</li>
                            <li>🎯 Priority support</li>
                        </ul>
                        <button class="buy-btn" data-product="ruby_subscription" data-price="9.99" data-coins="100000">
                            Subscribe Now
                        </button>
                    </div>
                </div>
            </div>

            <!-- Info Section -->
            <div class="info-section">
                <div class="info-card">
                    <h3>💡 How It Works</h3>
                    <ol>
                        <li>Enter your Discord username and User ID</li>
                        <li>Select the coin pack or subscription you want</li>
                        <li>Complete the purchase (currently demo mode)</li>
                        <li>Coins are automatically added to your account</li>
                        <li>Use <code>/balance</code> in Discord to check your coins</li>
                    </ol>
                </div>
                <div class="info-card">
                    <h3>🎁 Subscription Benefits</h3>
                    <ul>
                        <li><strong>Diamond:</strong> 5% bonus on all coin purchases</li>
                        <li><strong>Ruby:</strong> 10% bonus on all coin purchases</li>
                        <li><strong>VIP Access:</strong> Exclusive Discord channels</li>
                        <li><strong>Monthly Coins:</strong> Free coins every month</li>
                    </ul>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <!-- Purchase Modal -->
    <div id="purchaseModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <div id="modalBody">
                <!-- Content will be inserted here -->
            </div>
        </div>
    </div>

    <!-- PayPal SDK -->
    <script src="https://www.paypal.com/sdk/js?client-id=<%= paypalClientId %>&currency=USD&intent=capture&enable-funding=venmo,paylater"></script>
    
    <script>
        // Shop functionality with PayPal integration
        document.addEventListener('DOMContentLoaded', function() {
            const buyButtons = document.querySelectorAll('.buy-btn');
            const modal = document.getElementById('purchaseModal');
            const modalBody = document.getElementById('modalBody');
            const closeBtn = document.querySelector('.close');

            // Buy button click handlers
            buyButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const productType = this.getAttribute('data-product');
                    const price = this.getAttribute('data-price');
                    const coins = this.getAttribute('data-coins');
                    const userId = document.getElementById('userId').value;
                    const discordUsername = document.getElementById('discordUsername').value;

                    // User is already authenticated, no need for validation
                    showPurchaseConfirmation(productType, price, coins, userId, discordUsername);
                });
            });

            // Modal close handlers
            closeBtn.addEventListener('click', closeModal);
            window.addEventListener('click', function(event) {
                if (event.target === modal) {
                    closeModal();
                }
            });

            function showPurchaseConfirmation(productType, price, coins, userId, discordUsername) {
                const productNames = {
                    'coins_200k': '💎 200K Coins Pack',
                    'coins_500k': '👑 500K Coins Pack', 
                    'coins_1m': '🚀 1M Coins Pack',
                    'diamond_subscription': '💎 Diamond Subscription',
                    'ruby_subscription': '🔴 Ruby Subscription'
                };

                modalBody.innerHTML = `
                    <h2>🛒 Confirm Purchase</h2>
                    <div class="purchase-details">
                        <p><strong>Product:</strong> ${productNames[productType]}</p>
                        <p><strong>Price:</strong> $${price}${productType.includes('subscription') ? '/month' : ''}</p>
                        <p><strong>Coins:</strong> ${parseInt(coins).toLocaleString()}</p>
                        <p><strong>Discord User:</strong> ${discordUsername}</p>
                        <p><strong>User ID:</strong> ${userId}</p>
                    </div>
                    <div style="margin: 2rem 0;">
                        <p><strong>💳 Secure Payment via PayPal</strong></p>
                        <p>You will be redirected to PayPal to complete your purchase securely.</p>
                    </div>
                    <div id="paypal-button-container" style="margin: 1rem 0;"></div>
                    <div class="modal-buttons">
                        <button id="cancelPurchase" class="btn-secondary">Cancel</button>
                    </div>
                `;

                modal.style.display = 'block';

                // Initialize PayPal button
                paypal.Buttons({
                    createOrder: async function() {
                        try {
                            const response = await fetch('/create-paypal-order', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    productType: productType,
                                    userId: userId,
                                    discordUsername: discordUsername
                                })
                            });

                            const result = await response.json();
                            
                            if (!result.success) {
                                throw new Error(result.message || 'Failed to create order');
                            }

                            return result.orderId;
                        } catch (error) {
                            console.error('Error creating PayPal order:', error);
                            alert('Failed to create PayPal order. Please try again.');
                            throw error;
                        }
                    },
                    onApprove: async function(data) {
                        try {
                            modalBody.innerHTML = '<div class="loading">Processing your payment...</div>';

                            const response = await fetch('/capture-paypal-order', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    orderId: data.orderID
                                })
                            });

                            const result = await response.json();

                            if (result.success) {
                                modalBody.innerHTML = `
                                    <div class="success-message">
                                        <h2>🎉 Payment Successful!</h2>
                                        <p>${result.message}</p>
                                        <p><strong>Order ID:</strong> ${result.orderId}</p>
                                        <p>Use <code>/balance</code> in Discord to check your new balance!</p>
                                        <button id="closeSuccess" class="btn-primary">Close</button>
                                    </div>
                                `;
                                document.getElementById('closeSuccess').addEventListener('click', closeModal);
                            } else {
                                modalBody.innerHTML = `
                                    <div class="error-message">
                                        <h2>❌ Payment Failed</h2>
                                        <p>${result.message}</p>
                                        <button id="closeError" class="btn-secondary">Close</button>
                                    </div>
                                `;
                                document.getElementById('closeError').addEventListener('click', closeModal);
                            }
                        } catch (error) {
                            console.error('Error processing payment:', error);
                            modalBody.innerHTML = `
                                <div class="error-message">
                                    <h2>❌ Processing Error</h2>
                                    <p>An error occurred while processing your payment. Please contact support if you were charged.</p>
                                    <button id="closeError" class="btn-secondary">Close</button>
                                </div>
                            `;
                            document.getElementById('closeError').addEventListener('click', closeModal);
                        }
                    },
                    onCancel: function() {
                        closeModal();
                    },
                    onError: function(err) {
                        console.error('PayPal error:', err);
                        modalBody.innerHTML = `
                            <div class="error-message">
                                <h2>❌ Payment Error</h2>
                                <p>There was an error with PayPal. Please try again.</p>
                                <button id="closeError" class="btn-secondary">Close</button>
                            </div>
                        `;
                        document.getElementById('closeError').addEventListener('click', closeModal);
                    },
                    style: {
                        color: 'blue',
                        shape: 'rect',
                        label: 'paypal',
                        height: 40
                    }
                }).render('#paypal-button-container');

                document.getElementById('cancelPurchase').addEventListener('click', closeModal);
            }

            function closeModal() {
                modal.style.display = 'none';
            }
        });
    </script>
</body>
</html>