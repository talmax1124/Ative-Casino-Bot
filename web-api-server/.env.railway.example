# Railway Environment Variables for Web API Server
# Copy these values to your Railway service's environment variables

# Discord OAuth Application Credentials
DISCORD_CLIENT_ID=1404027373048823838
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET_HERE

# Discord Bot Token (for API calls)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN

# Firebase Configuration
FIREBASE_PROJECT_ID=ativecasino
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_PRIVATE_KEY
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@ativecasino.iam.gserviceaccount.com

# Environment Configuration
ENVIRONMENT=production
PORT=5001

# MongoDB Backup (optional)
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING
MONGODB_DB_NAME=ative_casino_backup