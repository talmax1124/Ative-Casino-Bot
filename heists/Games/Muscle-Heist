// muscle_heist.js
// Node 18+, discord.js v14
// npm i discord.js

const {
  Client,
  GatewayIntentBits,
  Partials,
  SlashCommandBuilder,
  REST,
  Routes,
  EmbedBuilder,
  ActionRowBuilder,
  ButtonBuilder,
  ButtonStyle,
  Collection,
} = require('discord.js');

const { randomInt } = require('crypto');

// ---------- CONFIG ----------
const TOKEN = process.env.DISCORD_TOKEN;            // setze als Env-Var
const CLIENT_ID = process.env.DISCORD_CLIENT_ID;    // Bot Application ID
const GUILD_ID = process.env.DISCORD_GUILD_ID;      // optional für Guild-Register

const JOIN_WINDOW = 20;           // Sekunden fürs Joinen
const SUPPORT_BONUS_PER = 5;      // +5 pro Supporter
const SUPPORT_BONUS_CAP = 25;     // max +25
const BUTTON_MASH_SECONDS = 5;    // Stage 2
const PUSH_TIME_BASE = 12;        // Stage 3 Grundzeit
const PUSH_TIME_PER_PLAYER = 2;   // extra Sekunden pro Spieler
const PUSH_TARGET_BASE = 60;      // Basiszielpunkte
const DRAW_DELAY_MIN = 2;         // Stage 4 min Delay
const DRAW_DELAY_MAX = 5;         // Stage 4 max Delay

// ---------- CLIENT ----------
const client = new Client({
  intents: [
    GatewayIntentBits.Guilds,
    GatewayIntentBits.GuildMessages,
    GatewayIntentBits.MessageContent, // wichtig für Stage 2 & 4
  ],
  partials: [Partials.Channel],
});

// Slash-Command definieren
const heistCmd = new SlashCommandBuilder()
  .setName('heistmuscle')
  .setDescription('Start a 4-stage Muscle Heist (Brute Force, Action, Reflexes).')
  .addIntegerOption(opt =>
    opt.setName('target')
      .setDescription('Target number for the d100 Strength Roll (0-100).')
      .setRequired(true)
      .setMinValue(0)
      .setMaxValue(100)
  );

// Einfache Session-Verwaltung: 1 Session pro Channel
const sessions = new Map(); // channelId -> session

// Utils
const mention = (id) => `<@${id}>`;
const progressBar = (current, total, width = 24) => {
  const safeTotal = Math.max(1, total);
  const ratio = Math.max(0, Math.min(1, current / safeTotal));
  const filled = Math.round(ratio * width);
  return `[${'█'.repeat(filled)}${' '.repeat(width - filled)}] ${Math.floor(ratio * 100)}%`;
};

async function safeEdit(message, payload) {
  try {
    await message.edit(payload);
  } catch { /* noop */ }
}

// ---------- REGISTER COMMAND ----------
async function registerCommands() {
  const rest = new REST({ version: '10' }).setToken(TOKEN);
  if (GUILD_ID) {
    await rest.put(Routes.applicationGuildCommands(CLIENT_ID, GUILD_ID), { body: [heistCmd.toJSON()] });
    console.log('Registered guild command /heistmuscle');
  } else {
    await rest.put(Routes.applicationCommands(CLIENT_ID), { body: [heistCmd.toJSON()] });
    console.log('Registered global command /heistmuscle (kann bis zu 1h dauern)');
  }
}

// ---------- GAME FLOW ----------
client.on('interactionCreate', async (interaction) => {
  if (!interaction.isChatInputCommand()) return;
  if (interaction.commandName !== 'heistmuscle') return;

  const target = interaction.options.getInteger('target', true);
  const channelId = interaction.channelId;

  if (sessions.get(channelId)?.active) {
    return interaction.reply({ content: 'In diesem Kanal läuft bereits ein Heist.', ephemeral: true });
  }

  await interaction.deferReply();

  // Session-Objekt
  const session = {
    active: true,
    started: false,
    channelId,
    guildId: interaction.guildId,
    leaderId: interaction.user.id,
    target,
    players: [interaction.user.id],
    supporters: new Set(),
    messages: {},
    lock: false, // einfacher Lock
  };
  sessions.set(channelId, session);

  // ---------- Lobby ----------
  const joinView = new ActionRowBuilder().addComponents(
    new ButtonBuilder().setCustomId('join_heist').setStyle(ButtonStyle.Success).setLabel('Join Heist').setEmoji('🧑‍🤝‍🧑')
  );

  const lobbyEmbed = new EmbedBuilder()
    .setTitle('💣 HEIST LOBBY')
    .setColor(0xFFA500)
    .addFields(
      { name: 'Leader', value: mention(session.leaderId), inline: true },
      { name: 'Target (Stage 1)', value: `${target} (d100, support bonus possible)`, inline: true }
    )
    .setFooter({ text: `Join window: ${JOIN_WINDOW}s` });

  await interaction.editReply({ embeds: [lobbyEmbed], components: [joinView] });
  const lobbyMsg = await interaction.fetchReply();
  session.messages.lobby = lobbyMsg;

  // Button Collector für Join
  const joinCollector = lobbyMsg.createMessageComponentCollector({ time: JOIN_WINDOW * 1000 });
  joinCollector.on('collect', async (i) => {
    if (i.customId !== 'join_heist') return;
    if (i.user.id === session.leaderId && session.players.includes(i.user.id)) {
      return i.reply({ content: 'Du bist schon drin!', ephemeral: true });
    }
    if (session.players.includes(i.user.id)) {
      return i.reply({ content: 'Du bist schon drin!', ephemeral: true });
    }
    session.players.push(i.user.id);
    await i.reply({ content: `${i.user} joined! (${session.players.length} players)`, ephemeral: true });
  });

  joinCollector.on('end', async () => {
    session.started = true;
    await lobbyMsg.edit({ components: [] });
    await interaction.followUp(`🔒 Lobby closed. Players (${session.players.length}): ${session.players.map(mention).join(', ')}`);
    // weiter zu Stage 1
    await stage1_StrengthRoll(session, interaction.channel);
  });
});

// ---------- Stage 1: Strength Roll ----------
async function stage1_StrengthRoll(session, channel) {
  if (!session.active) return;

  const supportRow = new ActionRowBuilder().addComponents(
    new ButtonBuilder().setCustomId('support_leader').setStyle(ButtonStyle.Primary).setEmoji('💪').setLabel('Support the Leader (+5)')
  );

  const embed = new EmbedBuilder()
    .setTitle('🟡 Stage 1 – Strength Roll (d100)')
    .setColor(0xFFD700)
    .setDescription(
      `Leader: ${mention(session.leaderId)}\n` +
      `Target: **${session.target}**\n` +
      `Click **Support** for +${SUPPORT_BONUS_PER} (max +${SUPPORT_BONUS_CAP}). **10s** window!`
    );

  const msg = await channel.send({ embeds: [embed], components: [supportRow] });
  session.messages.stage1 = msg;

  const collector = msg.createMessageComponentCollector({ time: 10_000 });
  collector.on('collect', async (i) => {
    if (i.customId !== 'support_leader') return;
    if (!session.players.includes(i.user.id)) return i.reply({ content: 'Only heist players can support.', ephemeral: true });
    if (i.user.id === session.leaderId) return i.reply({ content: 'Leader cannot support themselves.', ephemeral: true });
    if (session.supporters.has(i.user.id)) return i.reply({ content: 'You already supported.', ephemeral: true });
    session.supporters.add(i.user.id);
    const bonus = Math.min(SUPPORT_BONUS_CAP, SUPPORT_BONUS_PER * session.supporters.size);
    await i.reply({ content: `Support counted! Current bonus: **+${bonus}**`, ephemeral: true });
  });

  collector.on('end', async () => {
    await msg.edit({ components: [] });

    const bonus = Math.min(SUPPORT_BONUS_CAP, SUPPORT_BONUS_PER * session.supporters.size);
    const roll = randomInt(1, 101); // 1..100
    const total = roll + bonus;
    const success = total >= session.target;

    await channel.send(`🎲 Roll: **${roll}** | Bonus: **+${bonus}** | Total: **${total}** → ${success ? '✅ **SUCCESS!**' : '❌ **FAIL!**'}`);

    if (!success) {
      await channel.send('Heist failed at Stage 1. Try `/heistmuscle` again!');
      session.active = false;
      return;
    }
    await stage2_ButtonMashing(session, channel);
  });
}

// ---------- Stage 2: Button Mashing (💪 count) ----------
async function stage2_ButtonMashing(session, channel) {
  if (!session.active) return;

  const embed = new EmbedBuilder()
    .setTitle('🟡 Stage 2 – Button Mashing')
    .setColor(0xFFD700)
    .setDescription(`**Type "💪" as many times as you can in ${BUTTON_MASH_SECONDS}s!** Messages with the emoji are counted.`);

  const msg = await channel.send({ embeds: [embed] });
  session.messages.stage2 = msg;

  const counts = new Map(); // userId -> number
  session.players.forEach((id) => counts.set(id, 0));

  const endAt = Date.now() + BUTTON_MASH_SECONDS * 1000;

  const collector = channel.createMessageCollector({
    time: BUTTON_MASH_SECONDS * 1000,
    filter: (m) => !m.author.bot && session.players.includes(m.author.id) && m.content.includes('💪'),
  });

  await channel.send(`GO!`);
  collector.on('collect', (m) => {
    const c = (m.content.match(/💪/g) || []).length;
    counts.set(m.author.id, (counts.get(m.author.id) || 0) + c);
  });

  collector.on('end', async () => {
    await channel.send(`STOP!`);

    // niemand?
    if ([...counts.values()].every((v) => v === 0)) {
      await channel.send('Nobody sent 💪 — heist fails here.');
      session.active = false;
      return;
    }

    // winner
    const sorted = [...counts.entries()].sort((a, b) => b[1] - a[1]);
    const [winnerId, winCount] = sorted[0];

    const scoreboard = sorted.map(([uid, c]) => `${mention(uid)}: **${c}**`).join('\n');
    await channel.send(`🏆 Winner: ${mention(winnerId)} with **${winCount}**\n\n**Scoreboard:**\n${scoreboard}`);

    await stage3_PushChallenge(session, channel);
  });
}

// ---------- Stage 3: Push Challenge (button spam fills bar) ----------
async function stage3_PushChallenge(session, channel) {
  if (!session.active) return;

  const playerCount = Math.max(1, session.players.length);
  const pushTime = PUSH_TIME_BASE + Math.max(0, playerCount - 1) * PUSH_TIME_PER_PLAYER;
  const pushTarget = Math.floor(PUSH_TARGET_BASE * (1 + (playerCount - 1) * 0.25));
  let current = 0;

  const pushRow = new ActionRowBuilder().addComponents(
    new ButtonBuilder().setCustomId('push_bar').setStyle(ButtonStyle.Danger).setLabel('PUSH!').setEmoji('🏋️')
  );

  const makeEmbed = () =>
    new EmbedBuilder()
      .setTitle('🟡 Stage 3 – Push Challenge')
      .setColor(0xFFD700)
      .setDescription(
        `Spam **PUSH!** to fill the bar before time runs out.\n` +
        `Time: **${pushTime}s** – Target: **${pushTarget}** points\n\n` +
        `${progressBar(current, pushTarget, 26)}\nPoints: **${current}/${pushTarget}**`
      );

  const msg = await channel.send({ embeds: [makeEmbed()], components: [pushRow] });
  session.messages.stage3 = msg;

  const btnCollector = msg.createMessageComponentCollector({ time: pushTime * 1000 });
  btnCollector.on('collect', async (i) => {
    if (i.customId !== 'push_bar') return;
    if (!session.players.includes(i.user.id)) return i.reply({ content: 'Only heist players can PUSH!', ephemeral: true });
    current += 1;
    await i.deferUpdate();
  });

  // Fortschritt updater
  const updater = setInterval(() => {
    safeEdit(msg, { embeds: [makeEmbed()], components: [pushRow] });
    if (current >= pushTarget) {
      clearInterval(updater);
      btnCollector.stop('filled');
    }
  }, 400);

  btnCollector.on('end', async (_c, reason) => {
    clearInterval(updater);
    await msg.edit({ components: [] });

    if (current < pushTarget) {
      await channel.send('❌ Time is up — bar not full! Heist failed.');
      session.active = false;
      return;
    }
    await channel.send('✅ Stage passed!');
    await stage4_GuardShowdown(session, channel);
  });
}

// ---------- Stage 4: Guard Showdown (reaction speed) ----------
async function stage4_GuardShowdown(session, channel) {
  if (!session.active) return;

  const embed = new EmbedBuilder()
    .setTitle('🟡 Stage 4 – Guard Showdown')
    .setColor(0xFFD700)
    .setDescription('Wait for **DRAW**… once it appears, the **first** player to type `HIT` wins. Too early = fail.');

  const msg = await channel.send({ embeds: [embed] });
  session.messages.stage4 = msg;

  const delay = randomInt(DRAW_DELAY_MIN, DRAW_DELAY_MAX + 1); // inclusive range
  await wait(delay * 1000);
  const drawMsg = await channel.send('**DRAW!** (type `HIT`)');
  const drawTime = Date.now();

  let winner = null;

  const collector = channel.createMessageCollector({
    time: 4_000,
    filter: (m) =>
      !m.author.bot &&
      session.players.includes(m.author.id) &&
      m.content.trim().toLowerCase() === 'hit',
  });

  collector.on('collect', (m) => {
    if (winner) return; // already have one
    // simple check: must be after drawMsg timestamp (race in ms-level)
    if (m.createdTimestamp >= drawTime) {
      winner = m.author.id;
      collector.stop('winner');
    }
  });

  collector.on('end', async (_c, reason) => {
    if (!winner) {
      await channel.send('Nobody typed `HIT` in time — heist narrowly failed.');
      sessions.get(session.channelId).active = false;
      return;
    }
    await channel.send(
      `🏆 **HEIST COMPLETE!** Showdown winner: ${mention(winner)}\n` +
      `Team: ${session.players.map(mention).join(', ')}`
    );
    sessions.get(session.channelId).active = false;
  });
}

// ---------- HELPERS ----------
function wait(ms) {
  return new Promise((res) => setTimeout(res, ms));
}

// ---------- BOOT ----------
client.once('ready', () => {
  console.log(`Logged in as ${client.user.tag}`);
});

(async () => {
  if (!TOKEN || !CLIENT_ID) {
    console.error('Bitte setze DISCORD_TOKEN und DISCORD_CLIENT_ID als Umgebungsvariablen.');
    process.exit(1);
  }
  await registerCommands();
  await client.login(TOKEN);
})();
