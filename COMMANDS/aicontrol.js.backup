/**
 * AI Control Command - Manage and test the Real AI Engine
 */

const { SlashCommandBuilder, EmbedBuilder } = require('discord.js');
const realAI = require('../UTILS/realAIEngine');
const { gameDataCollector } = require('../UTILS/gameDataCollector');
const { fmt } = require('../UTILS/common');
const logger = require('../UTILS/logger');

module.exports = {
    data: new SlashCommandBuilder()
        .setName('aicontrol')
        .setDescription('🤖 Manage and test the Real AI Engine')
        .addSubcommand(subcommand =>
            subcommand
                .setName('status')
                .setDescription('Check AI engine status and configuration')
        )
        .addSubcommand(subcommand =>
            subcommand
                .setName('test')
                .setDescription('Test AI analysis with current casino data')
        )
        .addSubcommand(subcommand =>
            subcommand
                .setName('analyze')
                .setDescription('Run full AI analysis and get recommendations')
        )
        .addSubcommand(subcommand =>
            subcommand
                .setName('memory')
                .setDescription('View AI learning memory and insights')
        )
        .addSubcommand(subcommand =>
            subcommand
                .setName('dashboard')
                .setDescription('Complete AI overview: status, stats, analysis & recommendations')
        ),

    async execute(interaction) {
        const subcommand = interaction.options.getSubcommand();
        const userId = interaction.user.id;
        const DEVELOPER_ID = '466050111680544798';

        // Only developer can use AI control
        if (userId !== DEVELOPER_ID) {
            const embed = new EmbedBuilder()
                .setTitle('❌ Access Denied')
                .setDescription('Only the developer can access AI control features.')
                .setColor(0xFF0000);
            return await interaction.reply({ embeds: [embed], ephemeral: true });
        }

        try {
            switch (subcommand) {
                case 'status':
                    await this.handleStatus(interaction);
                    break;
                case 'test':
                    await this.handleTest(interaction);
                    break;
                case 'analyze':
                    await this.handleAnalyze(interaction);
                    break;
                case 'memory':
                    await this.handleMemory(interaction);
                    break;
                case 'dashboard':
                    await this.handleDashboard(interaction);
                    break;
            }
        } catch (error) {
            logger.error(`AI Control error: ${error.message}`);
            
            const errorEmbed = new EmbedBuilder()
                .setTitle('❌ AI Control Error')
                .setDescription(`Failed to execute AI command: ${error.message}`)
                .setColor(0xFF0000);
                
            await interaction.reply({ embeds: [errorEmbed], ephemeral: true });
        }
    },

    async handleStatus(interaction) {
        await interaction.deferReply({ ephemeral: true });

        const aiStatus = realAI.getAIStatus();
        const hasApiKey = !!process.env.OPENAI_API_KEY && process.env.OPENAI_API_KEY !== 'your_openai_api_key_here';

        const statusEmbed = new EmbedBuilder()
            .setTitle('🤖 Real AI Engine Status')
            .setColor(hasApiKey ? 0x00FF00 : 0xFFAA00)
            .addFields([
                {
                    name: '🔑 API Configuration',
                    value: hasApiKey 
                        ? '✅ OpenAI API Key Configured' 
                        : '⚠️ OpenAI API Key Not Set',
                    inline: true
                },
                {
                    name: '🧠 AI Model',
                    value: aiStatus.model || 'gpt-4',
                    inline: true
                },
                {
                    name: '📊 Learning Memory',
                    value: `${aiStatus.learningMemorySize || 0} entries`,
                    inline: true
                },
                {
                    name: '🎯 Average Accuracy',
                    value: `${(aiStatus.averageAccuracy || 0).toFixed(1)}%`,
                    inline: true
                },
                {
                    name: '⏰ Last Analysis',
                    value: aiStatus.lastAnalysis 
                        ? new Date(aiStatus.lastAnalysis).toLocaleString()
                        : 'Never',
                    inline: true
                },
                {
                    name: '🚀 Status',
                    value: hasApiKey 
                        ? '🟢 **REAL AI ACTIVE** - GPT-4 powered analysis'
                        : '🟡 **FALLBACK MODE** - Set OPENAI_API_KEY in .env',
                    inline: false
                }
            ]);

        if (!hasApiKey) {
            statusEmbed.addFields([
                {
                    name: '🔧 Setup Instructions',
                    value: '1. Get API key from https://platform.openai.com/account/api-keys\n' +
                           '2. Add `OPENAI_API_KEY=your_key_here` to .env file\n' +
                           '3. Restart the bot\n' +
                           '4. Run `/aicontrol test` to verify',
                    inline: false
                }
            ]);
        }

        await interaction.editReply({ embeds: [statusEmbed] });
    },

    async handleTest(interaction) {
        await interaction.deferReply({ ephemeral: true });

        const testEmbed = new EmbedBuilder()
            .setTitle('🧪 Testing Real AI Engine...')
            .setDescription('Running AI connectivity and analysis test...')
            .setColor(0xFFAA00);

        await interaction.editReply({ embeds: [testEmbed] });

        try {
            // Prepare test data
            const testGameData = {
                totalGames: 150,
                winRate: 0.42,
                houseEdge: 0.11,
                avgBetSize: 25000,
                totalVolume: 3750000,
                houseProfit: 412500
            };

            const testTrends = {
                volumeTrend: 'increasing',
                winRateTrend: 'stable',
                houseEdgeTrend: 'stable',
                playerActivity: 'increasing'
            };

            const testEconomicState = {
                riskLevel: 'LOW',
                volatility: 0.3,
                playerSatisfaction: 0.7,
                wealthDistribution: 'balanced'
            };

            // Test AI analysis
            const startTime = Date.now();
            const recommendations = await realAI.generateIntelligentRecommendations(
                testGameData,
                testTrends,
                testEconomicState
            );
            const responseTime = Date.now() - startTime;

            // Build results embed
            const resultsEmbed = new EmbedBuilder()
                .setTitle('✅ AI Engine Test Results')
                .setColor(0x00FF00)
                .addFields([
                    {
                        name: '🔗 Connection Status',
                        value: '✅ Successfully connected to OpenAI GPT-4',
                        inline: false
                    },
                    {
                        name: '⏱️ Response Time',
                        value: `${responseTime}ms`,
                        inline: true
                    },
                    {
                        name: '📊 Recommendations Generated',
                        value: `${recommendations.length} intelligent suggestions`,
                        inline: true
                    },
                    {
                        name: '🧠 AI Recommendations',
                        value: recommendations.slice(0, 3).map((rec, i) => 
                            `${i + 1}. **${rec.action}** (${rec.confidence}% confidence)\n   ${rec.reasoning}`
                        ).join('\n\n'),
                        inline: false
                    }
                ]);

            await interaction.editReply({ embeds: [resultsEmbed] });

        } catch (error) {
            const errorEmbed = new EmbedBuilder()
                .setTitle('❌ AI Test Failed')
                .setDescription(`AI Engine test failed: ${error.message}`)
                .setColor(0xFF0000)
                .addFields([
                    {
                        name: '🔧 Common Issues',
                        value: '• Check OPENAI_API_KEY in .env file\n' +
                               '• Verify API key has sufficient credits\n' +
                               '• Check internet connectivity\n' +
                               '• Ensure API key permissions are correct',
                        inline: false
                    }
                ]);

            await interaction.editReply({ embeds: [errorEmbed] });
        }
    },

    async handleAnalyze(interaction) {
        await interaction.deferReply({ ephemeral: true });

        const analyzeEmbed = new EmbedBuilder()
            .setTitle('🧠 Running Full AI Analysis...')
            .setDescription('Analyzing current casino data with GPT-4...')
            .setColor(0xFFAA00);

        await interaction.editReply({ embeds: [analyzeEmbed] });

        try {
            // Get actual casino data
            const stats = await gameDataCollector.getAggregatedStats();
            
            if (!stats) {
                throw new Error('No casino data available for analysis');
            }

            const resultsEmbed = new EmbedBuilder()
                .setTitle('🎯 AI Analysis Complete')
                .setColor(0x00FF00)
                .setDescription(`**Real AI Analysis** using ${stats.totalGames} games of data`)
                .addFields([
                    {
                        name: '📊 Current Metrics',
                        value: `• House Edge: ${(stats.houseEdge * 100).toFixed(1)}%\n` +
                               `• Win Rate: ${(stats.winRate * 100).toFixed(1)}%\n` +
                               `• Avg Bet: ${fmt(stats.avgBet)}\n` +
                               `• Total Volume: ${fmt(stats.totalVolume)}`,
                        inline: true
                    },
                    {
                        name: '🤖 AI Recommendations',
                        value: stats.recommendation.slice(0, 3).map((rec, i) => 
                            `${i + 1}. ${rec}`
                        ).join('\n'),
                        inline: false
                    },
                    {
                        name: '📈 Analysis Type',
                        value: '🧠 **Real AI Powered** - OpenAI GPT-4',
                        inline: false
                    }
                ]);

            await interaction.editReply({ embeds: [resultsEmbed] });

        } catch (error) {
            const errorEmbed = new EmbedBuilder()
                .setTitle('❌ Analysis Failed')
                .setDescription(`Could not complete AI analysis: ${error.message}`)
                .setColor(0xFF0000);

            await interaction.editReply({ embeds: [errorEmbed] });
        }
    },

    async handleMemory(interaction) {
        await interaction.deferReply({ ephemeral: true });

        try {
            const aiStatus = realAI.getAIStatus();
            const memory = realAI.getLearningMemory();

            const memoryEmbed = new EmbedBuilder()
                .setTitle('🧠 AI Learning Memory')
                .setColor(0x9932CC)
                .setDescription(`The AI has learned from ${aiStatus.learningMemorySize} past analyses`)
                .addFields([
                    {
                        name: '📚 Recent Learning Insights',
                        value: memory.length > 0 
                            ? memory.slice(0, 5).map((entry, i) => 
                                `${i + 1}. ${entry.insight} (${entry.accuracy}% accuracy)`
                              ).join('\n')
                            : 'No learning data yet - AI will learn as it analyzes more data',
                        inline: false
                    },
                    {
                        name: '🎯 Learning Progress',
                        value: `• Memory Entries: ${aiStatus.learningMemorySize}\n` +
                               `• Average Accuracy: ${(aiStatus.averageAccuracy || 0).toFixed(1)}%\n` +
                               `• Learning Status: ${memory.length > 0 ? 'Active' : 'Accumulating Data'}`,
                        inline: false
                    }
                ]);

            await interaction.editReply({ embeds: [memoryEmbed] });

        } catch (error) {
            const errorEmbed = new EmbedBuilder()
                .setTitle('❌ Memory Access Failed')
                .setDescription(`Could not access AI memory: ${error.message}`)
                .setColor(0xFF0000);

            await interaction.editReply({ embeds: [errorEmbed] });
        }
    },

    async handleDashboard(interaction) {
        await interaction.deferReply({ ephemeral: true });

        try {
            // Get AI status and casino data
            const aiStatus = realAI.getAIStatus();
            const stats = await gameDataCollector.getAggregatedStats();
            const memory = realAI.getLearningMemory();
            const hasApiKey = !!process.env.OPENAI_API_KEY && process.env.OPENAI_API_KEY !== 'your_openai_api_key_here';

            // Create comprehensive dashboard
            const dashboardEmbed = new EmbedBuilder()
                .setTitle('🤖 AI Casino Control Dashboard')
                .setColor(hasApiKey ? 0x00FF00 : 0xFFAA00)
                .setDescription(`**Complete AI Overview** - All systems in one view`)
                .addFields([
                    {
                        name: '🔧 System Status',
                        value: hasApiKey 
                            ? `✅ **GPT-4o ACTIVE** - Real AI analyzing casino\n⚡ Response: Fast\n🧠 Model: ${aiStatus.model}\n📊 Memory: ${aiStatus.learningMemorySize} entries`
                            : '⚠️ **FALLBACK MODE** - Set OPENAI_API_KEY',
                        inline: true
                    },
                    {
                        name: '📈 Casino Metrics',
                        value: stats 
                            ? `🎰 Games: ${stats.totalGames}\n💰 Volume: ${fmt(stats.totalVolume)}\n🏠 Edge: ${(stats.houseEdge * 100).toFixed(1)}%\n🎯 Win Rate: ${(stats.winRate * 100).toFixed(1)}%`
                            : 'No data available',
                        inline: true
                    },
                    {
                        name: '🎯 AI Performance',
                        value: `📊 Accuracy: ${(aiStatus.averageAccuracy || 0).toFixed(1)}%\n⏰ Last Analysis: ${aiStatus.lastAnalysis ? new Date(aiStatus.lastAnalysis).toLocaleString() : 'Never'}\n🧠 Learning: ${memory.length > 0 ? 'Active' : 'Building Data'}`,
                        inline: true
                    }
                ]);

            // Add AI recommendations if data available
            if (stats && hasApiKey) {
                try {
                    const recommendations = await realAI.generateIntelligentRecommendations(
                        stats,
                        { volumeTrend: 'stable', winRateTrend: 'stable', houseEdgeTrend: 'stable', playerActivity: 'normal' },
                        { riskLevel: 'MEDIUM', volatility: 0.3, playerSatisfaction: 0.75, wealthDistribution: 'balanced' }
                    );

                    dashboardEmbed.addFields([
                        {
                            name: '🤖 Live AI Recommendations',
                            value: recommendations.slice(0, 2).map((rec, i) => 
                                `${i + 1}. **${rec.action}** (${rec.confidence}% confidence)\n   ${rec.reasoning.slice(0, 80)}...`
                            ).join('\n\n'),
                            inline: false
                        }
                    ]);
                } catch (error) {
                    dashboardEmbed.addFields([
                        {
                            name: '🤖 AI Analysis',
                            value: `Error generating recommendations: ${error.message}`,
                            inline: false
                        }
                    ]);
                }
            }

            // Add quick actions
            dashboardEmbed.addFields([
                {
                    name: '⚡ Quick Commands',
                    value: '`/aicontrol test` - Test AI connectivity\n' +
                           '`/aicontrol analyze` - Full analysis\n' +
                           '`/mlstats` - ML statistics\n' +
                           '`/mlphase` - Economic phases',
                    inline: false
                }
            ]);

            await interaction.editReply({ embeds: [dashboardEmbed] });

        } catch (error) {
            const errorEmbed = new EmbedBuilder()
                .setTitle('❌ Dashboard Error')
                .setDescription(`Could not load AI dashboard: ${error.message}`)
                .setColor(0xFF0000);

            await interaction.editReply({ embeds: [errorEmbed] });
        }
    }
};