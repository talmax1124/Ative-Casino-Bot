/**
 * ATIVE Casino Bot - Backup Management Command
 * Admin command for managing database backups
 */

const { SlashCommandBuilder, EmbedBuilder, MessageFlags } = require('discord.js');
const { getGuildId, sendLogMessage } = require('../UTILS/common');
const logger = require('../UTILS/logger');

// Backup system components
const BackupManager = require('../UTILS/backupManager');
const BackupScheduler = require('../UTILS/backupScheduler');
const BackupRestore = require('../UTILS/backupRestore');
const CloudStorage = require('../UTILS/cloudStorage');

// Developer-only command
const DEVELOPER_ID = '466050111680544798';

module.exports = {
    data: new SlashCommandBuilder()
        .setName('backup')
        .setDescription('Manage database backups (Developer Only)')
        .addSubcommand(subcommand =>
            subcommand
                .setName('create')
                .setDescription('Create a manual backup')
                .addStringOption(option =>
                    option.setName('type')
                        .setDescription('Backup type')
                        .setRequired(false)
                        .addChoices(
                            { name: 'Full Backup', value: 'full' },
                            { name: 'Incremental', value: 'incremental' }
                        )
                )
        )
        .addSubcommand(subcommand =>
            subcommand
                .setName('list')
                .setDescription('List available backups')
                .addIntegerOption(option =>
                    option.setName('limit')
                        .setDescription('Number of backups to show')
                        .setRequired(false)
                        .setMinValue(1)
                        .setMaxValue(20)
                )
        )
        .addSubcommand(subcommand =>
            subcommand
                .setName('status')
                .setDescription('Show backup system status')
        )
        .addSubcommand(subcommand =>
            subcommand
                .setName('restore')
                .setDescription('Restore from backup (DANGER)')
                .addStringOption(option =>
                    option.setName('backup_id')
                        .setDescription('Backup ID to restore from')
                        .setRequired(true)
                )
                .addBooleanOption(option =>
                    option.setName('confirm')
                        .setDescription('Confirm restoration (THIS WILL OVERWRITE CURRENT DATA)')
                        .setRequired(true)
                )
        )
        .addSubcommand(subcommand =>
            subcommand
                .setName('schedule')
                .setDescription('Manage backup schedules')
                .addStringOption(option =>
                    option.setName('action')
                        .setDescription('Schedule action')
                        .setRequired(true)
                        .addChoices(
                            { name: 'Show Status', value: 'status' },
                            { name: 'Start Scheduler', value: 'start' },
                            { name: 'Stop Scheduler', value: 'stop' }
                        )
                )
        )
        .addSubcommand(subcommand =>
            subcommand
                .setName('cloud')
                .setDescription('Manage cloud backup settings')
                .addStringOption(option =>
                    option.setName('action')
                        .setDescription('Cloud action')
                        .setRequired(true)
                        .addChoices(
                            { name: 'Show Status', value: 'status' },
                            { name: 'Test Connection', value: 'test' }
                        )
                )
        ),

    async execute(interaction) {
        const userId = interaction.user.id;
        const guildId = await getGuildId(interaction);

        // Developer-only check
        if (userId !== DEVELOPER_ID) {
            const embed = new EmbedBuilder()
                .setTitle('❌ Access Denied')
                .setDescription('This command is restricted to the bot developer.')
                .setColor(0xFF0000)
                .setTimestamp();
            
            return await interaction.reply({ embeds: [embed], ephemeral: true });
        }

        const subcommand = interaction.options.getSubcommand();

        try {
            switch (subcommand) {
                case 'create':
                    await this.handleCreateBackup(interaction);
                    break;
                case 'list':
                    await this.handleListBackups(interaction);
                    break;
                case 'status':
                    await this.handleStatus(interaction);
                    break;
                case 'restore':
                    await this.handleRestore(interaction);
                    break;
                case 'schedule':
                    await this.handleSchedule(interaction);
                    break;
                case 'cloud':
                    await this.handleCloud(interaction);
                    break;
                default:
                    throw new Error(`Unknown subcommand: ${subcommand}`);
            }

        } catch (error) {
            logger.error(`Backup command error: ${error.message}`);
            
            const errorEmbed = new EmbedBuilder()
                .setTitle('❌ Backup Command Error')
                .setDescription(`An error occurred: ${error.message}`)
                .setColor(0xFF0000)
                .setTimestamp();

            if (!interaction.replied && !interaction.deferred) {
                await interaction.reply({ embeds: [errorEmbed], ephemeral: true });
            } else {
                await interaction.editReply({ embeds: [errorEmbed] });
            }

            // Log error
            await sendLogMessage(
                interaction.client,
                'error',
                `Backup command error for ${interaction.user.tag}: ${error.message}`,
                userId,
                guildId
            );
        }
    },

    async handleCreateBackup(interaction) {
        const type = interaction.options.getString('type') || 'full';
        
        await interaction.deferReply({ ephemeral: true });

        const embed = new EmbedBuilder()
            .setTitle('🔄 Creating Backup')
            .setDescription(`Starting ${type} backup...`)
            .setColor(0xFFFF00)
            .setTimestamp();

        await interaction.editReply({ embeds: [embed] });

        try {
            const backupManager = new BackupManager();
            await backupManager.initialize();

            let result;
            if (type === 'full') {
                result = await backupManager.createFullBackup();
            } else if (type === 'incremental') {
                // Get last backup timestamp
                const backups = await backupManager.listBackups();
                const lastTimestamp = backups.length > 0 ? backups[0].timestamp : null;
                result = await backupManager.createIncrementalBackup(lastTimestamp);
            }

            const successEmbed = new EmbedBuilder()
                .setTitle('✅ Backup Created Successfully')
                .setDescription(`**Backup ID:** ${result.id}\n**Type:** ${type}\n**Size:** ${this.formatBytes(result.metadata.size)}`)
                .setColor(0x00FF00)
                .setTimestamp();

            await interaction.editReply({ embeds: [successEmbed] });

            // Log success
            await sendLogMessage(
                interaction.client,
                'backup',
                `Manual backup created: ${result.id} (${type})`,
                interaction.user.id,
                await getGuildId(interaction)
            );

        } catch (error) {
            const errorEmbed = new EmbedBuilder()
                .setTitle('❌ Backup Creation Failed')
                .setDescription(`Failed to create backup: ${error.message}`)
                .setColor(0xFF0000)
                .setTimestamp();

            await interaction.editReply({ embeds: [errorEmbed] });
            throw error;
        }
    },

    async handleListBackups(interaction) {
        const limit = interaction.options.getInteger('limit') || 10;
        
        await interaction.deferReply({ ephemeral: true });

        try {
            const backupManager = new BackupManager();
            await backupManager.initialize();
            const backups = await backupManager.listBackups();

            if (backups.length === 0) {
                const embed = new EmbedBuilder()
                    .setTitle('📋 Available Backups')
                    .setDescription('No backups found.')
                    .setColor(0xFFFF00)
                    .setTimestamp();

                return await interaction.editReply({ embeds: [embed] });
            }

            const recentBackups = backups.slice(0, limit);
            let description = '';

            for (const backup of recentBackups) {
                const date = new Date(backup.timestamp).toLocaleString();
                const size = this.formatBytes(backup.size);
                const type = backup.type || 'full';
                
                description += `**${backup.id}**\n`;
                description += `📅 ${date}\n`;
                description += `📊 ${size} (${type})\n`;
                description += `${backup.encrypted ? '🔒' : '🔓'} ${backup.compressed ? '📦' : '📄'}\n\n`;
            }

            const embed = new EmbedBuilder()
                .setTitle(`📋 Available Backups (${recentBackups.length}/${backups.length})`)
                .setDescription(description)
                .setColor(0x00FF00)
                .setTimestamp();

            await interaction.editReply({ embeds: [embed] });

        } catch (error) {
            throw error;
        }
    },

    async handleStatus(interaction) {
        await interaction.deferReply({ ephemeral: true });

        try {
            const backupManager = new BackupManager();
            await backupManager.initialize();
            const status = await backupManager.getStatus();

            const embed = new EmbedBuilder()
                .setTitle('📊 Backup System Status')
                .addFields(
                    { name: '📁 Total Backups', value: status.totalBackups.toString(), inline: true },
                    { name: '💾 Total Size', value: status.totalSize, inline: true },
                    { name: '📍 Backup Directory', value: status.backupDirectory, inline: false }
                )
                .setColor(0x00FF00)
                .setTimestamp();

            if (status.latestBackup) {
                const latestDate = new Date(status.latestBackup.timestamp).toLocaleString();
                embed.addFields(
                    { name: '🕒 Latest Backup', value: `${status.latestBackup.id}\n${latestDate}`, inline: true }
                );
            }

            if (status.oldestBackup) {
                const oldestDate = new Date(status.oldestBackup.timestamp).toLocaleString();
                embed.addFields(
                    { name: '🕐 Oldest Backup', value: `${status.oldestBackup.id}\n${oldestDate}`, inline: true }
                );
            }

            await interaction.editReply({ embeds: [embed] });

        } catch (error) {
            throw error;
        }
    },

    async handleRestore(interaction) {
        const backupId = interaction.options.getString('backup_id');
        const confirm = interaction.options.getBoolean('confirm');

        if (!confirm) {
            const embed = new EmbedBuilder()
                .setTitle('⚠️ Restoration Cancelled')
                .setDescription('You must confirm the restoration to proceed. **THIS WILL OVERWRITE ALL CURRENT DATA!**')
                .setColor(0xFFFF00)
                .setTimestamp();

            return await interaction.reply({ embeds: [embed], ephemeral: true });
        }

        await interaction.deferReply({ ephemeral: true });

        const warningEmbed = new EmbedBuilder()
            .setTitle('⚠️ DANGEROUS OPERATION')
            .setDescription(`**RESTORING FROM BACKUP: ${backupId}**\n\n⚠️ **THIS WILL OVERWRITE ALL CURRENT DATA**\n🔄 Starting restoration process...`)
            .setColor(0xFF6600)
            .setTimestamp();

        await interaction.editReply({ embeds: [warningEmbed] });

        try {
            const backupRestore = new BackupRestore();
            await backupRestore.initialize();

            const result = await backupRestore.restoreFromBackup(backupId, {
                createPreBackup: true,
                skipVerification: false,
                stopServices: false // Don't actually stop the bot
            });

            const successEmbed = new EmbedBuilder()
                .setTitle('✅ Restoration Completed')
                .setDescription(`**Backup ID:** ${result.backupId}\n**Restored At:** ${result.restoredAt}\n\n⚠️ **Bot restart may be required**`)
                .setColor(0x00FF00)
                .setTimestamp();

            await interaction.editReply({ embeds: [successEmbed] });

            // Log critical action
            await sendLogMessage(
                interaction.client,
                'critical',
                `DATABASE RESTORED by ${interaction.user.tag} from backup: ${backupId}`,
                interaction.user.id,
                await getGuildId(interaction)
            );

        } catch (error) {
            const errorEmbed = new EmbedBuilder()
                .setTitle('❌ Restoration Failed')
                .setDescription(`Failed to restore from backup: ${error.message}\n\n⚠️ **Database may be in an inconsistent state**`)
                .setColor(0xFF0000)
                .setTimestamp();

            await interaction.editReply({ embeds: [errorEmbed] });
            throw error;
        }
    },

    async handleSchedule(interaction) {
        const action = interaction.options.getString('action');
        
        await interaction.deferReply({ ephemeral: true });

        try {
            const scheduler = new BackupScheduler();

            if (action === 'status') {
                const status = scheduler.getStatus();
                
                let scheduleText = '';
                for (const [name, schedule] of Object.entries(status.schedules)) {
                    const lastRun = schedule.lastRun ? new Date(schedule.lastRun).toLocaleString() : 'Never';
                    const nextRun = schedule.nextRun ? new Date(schedule.nextRun).toLocaleString() : 'Unknown';
                    
                    scheduleText += `**${name}** (${schedule.type})\n`;
                    scheduleText += `Status: ${schedule.enabled ? '✅ Active' : '❌ Inactive'}\n`;
                    scheduleText += `Last Run: ${lastRun}\n`;
                    scheduleText += `Next Run: ${nextRun}\n`;
                    scheduleText += `Failures: ${schedule.failures}\n\n`;
                }

                const embed = new EmbedBuilder()
                    .setTitle('🕒 Backup Schedule Status')
                    .setDescription(scheduleText || 'No schedules configured')
                    .addFields(
                        { name: 'System Status', value: status.initialized ? '✅ Initialized' : '❌ Not Initialized', inline: true },
                        { name: 'Cloud Backup', value: status.cloudEnabled ? `✅ ${status.cloudProvider}` : '❌ Disabled', inline: true }
                    )
                    .setColor(status.initialized ? 0x00FF00 : 0xFF0000)
                    .setTimestamp();

                await interaction.editReply({ embeds: [embed] });

            } else if (action === 'start') {
                await scheduler.initialize();
                
                const embed = new EmbedBuilder()
                    .setTitle('✅ Backup Scheduler Started')
                    .setDescription('Automatic backups are now active.')
                    .setColor(0x00FF00)
                    .setTimestamp();

                await interaction.editReply({ embeds: [embed] });

            } else if (action === 'stop') {
                scheduler.stop();
                
                const embed = new EmbedBuilder()
                    .setTitle('🛑 Backup Scheduler Stopped')
                    .setDescription('Automatic backups have been disabled.')
                    .setColor(0xFFFF00)
                    .setTimestamp();

                await interaction.editReply({ embeds: [embed] });
            }

        } catch (error) {
            throw error;
        }
    },

    async handleCloud(interaction) {
        const action = interaction.options.getString('action');
        
        await interaction.deferReply({ ephemeral: true });

        try {
            const cloudStorage = new CloudStorage();

            if (action === 'status') {
                const hasConfig = !!(process.env.DROPBOX_ACCESS_TOKEN || process.env.AWS_ACCESS_KEY_ID || process.env.BACKUP_WEBHOOK_URL);
                
                const embed = new EmbedBuilder()
                    .setTitle('☁️ Cloud Backup Status')
                    .addFields(
                        { name: 'Configuration', value: hasConfig ? '✅ Found' : '❌ Missing', inline: true },
                        { name: 'Active Provider', value: cloudStorage.activeProvider || 'None', inline: true }
                    )
                    .setDescription(hasConfig ? 'Cloud backup configuration detected' : 'No cloud backup configured. Set environment variables for your preferred provider.')
                    .setColor(hasConfig ? 0x00FF00 : 0xFFFF00)
                    .setTimestamp();

                await interaction.editReply({ embeds: [embed] });

            } else if (action === 'test') {
                const embed = new EmbedBuilder()
                    .setTitle('☁️ Cloud Connection Test')
                    .setDescription('Cloud connection testing not yet implemented')
                    .setColor(0xFFFF00)
                    .setTimestamp();

                await interaction.editReply({ embeds: [embed] });
            }

        } catch (error) {
            throw error;
        }
    },

    formatBytes(bytes) {
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        if (bytes === 0) return '0 Bytes';
        const i = Math.floor(Math.log(bytes) / Math.log(1024));
        return `${(bytes / Math.pow(1024, i)).toFixed(2)} ${sizes[i]}`;
    }
};